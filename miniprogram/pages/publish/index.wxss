page {
  background: #f7f3ea;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 160rpx;
  box-sizing: border-box;
}

.header {
  padding: 20rpx 4rpx 8rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #3a2417;
}

.subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8a7660;
}

.card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 32rpx rgba(104, 73, 42, 0.08);
}

.login-card {
  text-align: center;
}

.login-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3a2417;
}

.login-desc {
  margin-top: 16rpx;
  color: #8a7660;
  font-size: 26rpx;
  line-height: 1.6;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  height: 84rpx;
  line-height: normal;
  padding: 0;
  border-radius: 999rpx;
  color: #fff;
  background: #b15c2d;
  font-size: 30rpx;
  font-weight: 700;
}

.label {
  font-size: 30rpx;
  font-weight: 700;
  color: #3a2417;
}

.gap {
  margin-top: 34rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.chip {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #f3eadc;
  color: #7a604a;
  font-size: 26rpx;
}

.chip.active {
  background: #b15c2d;
  color: #fff;
  font-weight: 600;
}

.textarea {
  margin-top: 18rpx;
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f8f0e5;
  color: #3a2417;
  font-size: 28rpx;
}

.notice {
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  background: #fff6e8;
  color: #8a5a32;
  font-size: 24rpx;
  line-height: 1.6;
}

.submit {
  margin-top: 36rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #b15c2d;
  font-size: 30rpx;
  font-weight: 700;
}
