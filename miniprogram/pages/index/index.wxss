page {
  background: #f7f3ea;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 160rpx;
  box-sizing: border-box;
}

.hero {
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #fff4d8 0%, #ffd7b1 100%);
  color: #3a2417;
}

.eyebrow {
  font-size: 24rpx;
  color: #9b5a2e;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 700;
}

.subtitle {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #76553f;
}

.card,
.post-card,
.empty {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 32rpx rgba(104, 73, 42, 0.08);
}

.match-card {
  border: 2rpx solid rgba(177, 92, 45, 0.18);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3a2417;
}

.hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #9c8a78;
}

.match-group {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0e6d8;
}

.match-group:first-of-type {
  border-top: 0;
}

.my-post {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.badge {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff0dd;
  color: #b15c2d;
  font-size: 24rpx;
  font-weight: 600;
}

.my-post-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3a2417;
}

.match-count {
  font-size: 24rpx;
  color: #8a7660;
}

.match-count.muted {
  color: #b2a18d;
}

.active-order {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8f0e5;
}

.active-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.active-title {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #3a2417;
}

.active-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a7660;
}

.empty-inline {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f8f0e5;
  color: #8a7660;
  font-size: 26rpx;
  line-height: 1.6;
}

.match-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f8f0e5;
}

.match-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3a2417;
}

.match-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a7660;
}

.arrow {
  color: #b15c2d;
  font-size: 24rpx;
  font-weight: 700;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.summary-card {
  padding: 28rpx;
  border-radius: 26rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 32rpx rgba(104, 73, 42, 0.08);
}

.summary-wide {
  grid-column: span 2;
}

.summary-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #b15c2d;
}

.summary-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a7660;
}

.list-head {
  margin-top: 36rpx;
}

.filters {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.filters picker {
  flex: 1;
}

.filter-pill {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fffdf8;
  color: #7a604a;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(104, 73, 42, 0.08);
}

.empty {
  text-align: center;
  color: #8a7660;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3a2417;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.post-list {
  margin-top: 8rpx;
}

.post-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status {
  font-size: 24rpx;
  color: #9c8a78;
}

.post-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #3a2417;
}

.post-meta,
.remark {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7d6752;
}

.remark {
  line-height: 1.55;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0e6d8;
}
